     except ValueError:
         gib = math.nan
-    if not 2 <= gib <= total / GIB:
-        raise ValueError(f"TENSORFOLD_MEMORY_RESERVE_GIB={value}: a number of GiB from 2 to the memory's size")
+    if not 0 <= gib <= total / GIB:
+        raise ValueError(f"TENSORFOLD_MEMORY_RESERVE_GIB={value}: a number of GiB from 0 to the memory's size")
     return int(gib * GIB)
 
 


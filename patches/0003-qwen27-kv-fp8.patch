diff --git tensorfold/cuda/kv_fp8.py tensorfold/cuda/kv_fp8.py
--- /dev/null
+++ tensorfold/cuda/kv_fp8.py
@@ -0,0 +1,22 @@
+import os
+import torch
+
+def is_fp8() -> bool:
+    return os.environ.get("TENSORFOLD_KV_DTYPE", "").strip().lower() == "fp8"
+
+def dtype():
+    return torch.float8_e4m3fn if is_fp8() else torch.bfloat16
+
+def itemsize() -> int:
+    return 1 if is_fp8() else 2
+
+def round(tensor: torch.Tensor) -> torch.Tensor:
+    """Round keys and values through e4m3 before use if FP8 is on, so draft rows read identical to cache rows."""
+    if not is_fp8():
+        return tensor
+    orig_shape = tensor.shape
+    return tensor.to(torch.float8_e4m3fn).to(tensor.dtype).view(orig_shape)
+
+def dense(cache: torch.Tensor, rows: int) -> torch.Tensor:
+    """The prompt-attention kernel reads bf16: widen cache rows to bf16 for this layer."""
+    return cache[:rows] if cache.dtype == torch.bfloat16 else cache[:rows].to(torch.bfloat16)


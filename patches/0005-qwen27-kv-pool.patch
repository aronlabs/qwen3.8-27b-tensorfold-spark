diff --git tensorfold/cuda/kv_fp8.py tensorfold/cuda/kv_fp8.py
index d1d6f9f..d6610d9 100644
--- tensorfold/cuda/kv_fp8.py
+++ tensorfold/cuda/kv_fp8.py
@@ -20,3 +20,17 @@ def round(tensor: torch.Tensor) -> torch.Tensor:
 def dense(cache: torch.Tensor, rows: int) -> torch.Tensor:
     """The prompt-attention kernel reads bf16: widen cache rows to bf16 for this layer."""
     return cache[:rows] if cache.dtype == torch.bfloat16 else cache[:rows].to(torch.bfloat16)
+
+
+def pool_bytes() -> int:
+    """TENSORFOLD_KV_POOL_GIB: GiB of attention cache to pin for the concurrent streams at startup."""
+    value = os.environ.get("TENSORFOLD_KV_POOL_GIB", "").strip()
+    if not value or value.lower() == "auto":
+        return 0
+    try:
+        gib = float(value)
+    except ValueError:
+        gib = float("nan")
+    if not gib >= 0:
+        raise ValueError(f"TENSORFOLD_KV_POOL_GIB={value}: a number of GiB, 0 or more")
+    return int(gib * 1024**3)
diff --git tensorfold/cuda/memory_gate.py tensorfold/cuda/memory_gate.py
index 3bb0d6f..b3c9b91 100644
--- tensorfold/cuda/memory_gate.py
+++ tensorfold/cuda/memory_gate.py
@@ -37,4 +37,16 @@ def torch_live(torch, available: Callable) -> Callable[[], int]:
     return lambda: int(available(torch)) + int(torch.cuda.memory_reserved()) - int(torch.cuda.memory_allocated())
 
 
-__all__ = ["MemoryGate", "NoRoom", "torch_live"]
+class PoolGate(MemoryGate):
+    def __init__(self, pool: int, base: int, torch) -> None:
+        super().__init__(pool, 0, None)
+        self.base, self.torch = int(base), torch
+
+    def used(self) -> int:
+        return max(0, int(self.torch.cuda.memory_allocated()) - self.base)
+
+    def fits(self, extra: int) -> bool:
+        return self.used() + int(extra) <= self.room
+
+
+__all__ = ["MemoryGate", "NoRoom", "PoolGate", "torch_live"]
